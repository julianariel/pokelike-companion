{
  "name": "pokelike-companion",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run version:check && tsc && vite build",
    "package": "npm run build && cd dist && zip -r ../pokelike-companion-extension.zip .",
    "preview": "vite preview --host 127.0.0.1",
    "version:check": "node scripts/sync-manifest-version.mjs --check",
    "version:sync": "node scripts/sync-manifest-version.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^7.0.0",
    "typescript": "^5.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.329",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
